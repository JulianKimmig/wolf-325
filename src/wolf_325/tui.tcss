Screen {
    background: #0d141c;
    color: #d9e6ee;
}

#main-grid {
    height: 1fr;
    layout: horizontal;
}

#navigation {
    width: 31;
    min-width: 24;
    border-right: solid #31566b;
    background: #111e28;
    scrollbar-gutter: stable;
}

#value-pane {
    width: 1fr;
    padding: 0 1;
}

#search {
    height: 3;
    border: tall #31566b;
}

#view-title {
    height: 3;
    padding: 0 1;
    color: #76d7ea;
}

#register-table {
    height: 1fr;
    border: solid #31566b;
}

#detail-pane {
    width: 52;
    min-width: 38;
    padding: 0 1;
    border-left: solid #31566b;
    background: #101a23;
}

#detail-title {
    height: 2;
    color: #76d7ea;
    text-style: bold;
}

#register-details {
    height: 1fr;
    padding: 1;
    border: solid #31566b;
    overflow-y: auto;
}

#toolbar {
    height: auto;
    max-height: 10;
    layout: grid;
    grid-size: 2;
    grid-gutter: 0 1;
    padding-top: 1;
}

#toolbar Button {
    width: 1fr;
}

#connection-status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: #173044;
    color: #d5f3f7;
}

.dialog {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick #4db7cb;
    background: #12212c;
}

.dialog-title {
    text-style: bold;
    color: #76d7ea;
    margin-bottom: 1;
}

.dialog-actions, .field-row {
    height: 3;
    align: right middle;
    margin-top: 1;
}

.dialog-actions Button {
    margin-left: 1;
}

.field-row Label {
    width: 1fr;
    content-align: left middle;
}

.warning {
    margin-top: 1;
    color: #ffbf69;
    text-style: bold;
}

.error {
    min-height: 1;
    color: #ff7b72;
}

#profile-preview {
    height: 14;
    margin-top: 1;
    padding: 1;
    border: solid #31566b;
    overflow-y: auto;
}

#save-profile-preview {
    height: 12;
    margin-bottom: 1;
    padding: 1;
    border: solid #31566b;
    overflow-y: auto;
}

ModalScreen {
    align: center middle;
    background: #000000 60%;
}
